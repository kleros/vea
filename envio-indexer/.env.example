# Postgres (envio dev spins this up on port 5433 by default)
ENVIO_PG_HOST=localhost
ENVIO_PG_PORT=5433
ENVIO_PG_USER=postgres
ENVIO_PG_PASSWORD=testing
ENVIO_PG_DATABASE=envio-dev

# Hasura (envio dev spins this up on port 8080 by default)
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/metadata
HASURA_GRAPHQL_ADMIN_SECRET=testing

# Envio hosted service — required for `envio deploy`
ENVIO_API_TOKEN=
