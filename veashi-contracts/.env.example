# veashi-contracts deployment env. Copy to .env (gitignored) and fill ONE route; forge reads .env itself.
#
# Example route: Arbitrum One (42161) -> Story (1514).
# Only values verified for this route are filled (checked on chain on 2026-10-19: code at each address,
# endpoint eid(), gate getChainId() and lane support, library type and pathway). Every other chain-specific key
# and every key added for the PR #529 contracts is blank.
# A blank key counts as unset. The scripts fail on a blank required key and name it.
# Set each key once: forge keeps the first line of a key set twice, and deploy-route.sh refuses a duplicate of a key
# it reads itself (REPORTER_CHAIN_ID, ADAPTER_CHAIN_ID; VEA_INBOX, VEA_OUTBOX with --vea). A value exported in the
# shell wins over this file.
# Amounts are wei of the reporter chain's native token unless a comment says otherwise.

# ----------------------------------------------------------------------------
# Deployer and route
# ----------------------------------------------------------------------------

# Required. Private key of the deployer: it deploys everything and is the first governor of every contract.
# Never commit a value here.
DEPLOYER_KEY=

# Optional. Public address of the deployer, for the read-only check() of SetDispatcher and HandOver, so a governor
# signer can run them without DEPLOYER_KEY. A wrong address hides the "keeper is still the deployer" governor action.
# When DEPLOYER_KEY is also set they must match: --set-dispatcher and --handover refuse a mismatch before sending.
DEPLOYER_ADDRESS=

# Required. EVM chain ids of the route: reporters and Yaho live on the reporter chain, adapters, Yaru and Hashi on
# the adapter chain. They must differ and must match the RPCs passed to deploy-route.sh.
REPORTER_CHAIN_ID=42161
ADAPTER_CHAIN_ID=1514

# Not read by any script: the RPCs to pass as deploy-route.sh --reporter-chain / --adapter-chain (export them in the
# shell first, the script never sources this file). Public RPCs, cast chain-id checked.
REPORTER_RPC=https://arb1.arbitrum.io/rpc
ADAPTER_RPC=https://mainnet.storyrpc.io

# Optional. Explorer API key read by forge verify-contract at the end of a deploy run; without it forge uses Sourcify.
ETHERSCAN_API_KEY=

# ----------------------------------------------------------------------------
# Hashi
# ----------------------------------------------------------------------------

# Optional. An existing Yaho on the reporter chain / Yaru on the adapter chain to reuse instead of deploying one.
# Each must equal the route file's .yaho / .yaru when both are set. A reused Yaru must have YAHO() == the route's
# Yaho and SOURCE_CHAIN_ID() == REPORTER_CHAIN_ID. Empty = take it from the route file, or deploy with --hashi.
YAHO_ADDRESS=
YARU_ADDRESS=

# ----------------------------------------------------------------------------
# Roles
# ----------------------------------------------------------------------------

# Optional. Keeper of every reporter: receives every withdrawal, may move fees and gas limits within the guardrails,
# and is the LayerZero reporter's refund address. A contract keeper must accept native transfers.
# Empty = the deployer (HandOver then refuses on paid reporters unless NEW_KEEPER or KEEP_DEPLOYER_KEEPER is set).
# An explicit zero address is refused.
KEEPER_ADDRESS=

# Optional at deploy, required for --set-dispatcher. The gateway (a VouchedDispatcher) on the reporter chain that
# dispatches through the route's Yaho. Empty at deploy = reporters revert DispatcherNotSet until --set-dispatcher.
# Must be empty when --hashi deploys a new Yaho (a route's first deploy, or FORCE_NEW_HASHI): the preflight refuses it.
# Never the lightbulb Switch (it is not a VouchedDispatcher).
DISPATCHER_ADDRESS=

# Only when the gateway has no public yaho() getter: the Yaho it dispatches through, stated by the operator.
# Must equal the route's Yaho. Ignored when the gateway answers yaho(). It vouches only for DISPATCHER_ADDRESS, so
# keep both set for --handover and every later check(): HandOver checks each reporter's dispatcher the same way.
DISPATCHER_YAHO=

# Required for --handover. The governor (a multisig contract, e.g. a Safe) every governed contract moves to.
# Must be a contract on each chain (an EOA with an EIP-7702 delegation is refused) and differ from the deployer,
# the gateway (DISPATCHER_ADDRESS), the route's Yaho and every address in the route file.
GOVERNOR_ADDRESS=
# Optional. Per-side governor, when the multisig has a different address on the reporter / adapter chain.
# Empty = GOVERNOR_ADDRESS. Part of the route, not a one-shot: keep it set (here, not only in the shell) for every
# --handover rerun and every HandOver check(), or the contracts it governs read as foreign and HandOver refuses.
REPORTER_GOVERNOR_ADDRESS=
ADAPTER_GOVERNOR_ADDRESS=

# ----------------------------------------------------------------------------
# LayerZero (--lz). DVNs and confirmations come from script/config/layerzero.json, not from this file.
# ----------------------------------------------------------------------------

# Required. EndpointV2 on the reporter / adapter chain; each endpoint's eid() is checked.
LZ_REPORTER_ENDPOINT=0x1a44076050125825900e736c501f859c50fE728c
LZ_ADAPTER_ENDPOINT=0x3A73033C0b1407574C76BdBAc67f126f6b4a9AA9
# Required. LayerZero endpoint ids (uint32) of the reporter / adapter chain; both must exist in layerzero.json.
LZ_REPORTER_EID=30110
LZ_ADAPTER_EID=30364
# Required. SendUln302 on the reporter chain: registered on the endpoint, serves LZ_ADAPTER_EID, pinned on the reporter.
LZ_SEND_LIB=0x975bcD720be66659e3EB3C0e4F1866a3020E493A
# Required. Executor on the reporter chain, set in the reporter's executor config. The preflight has it quote lzReceive
# gas to LZ_ADAPTER_EID: a DVN or another non-executor fails, and the error names the send library's default executor.
LZ_EXECUTOR=0x31CAe3B7fB82d847621859fb1585353c5720660D
# Required. ReceiveUln302 on the adapter chain: registered, serves LZ_REPORTER_EID, pinned on the adapter.
LZ_RECEIVE_LIB=0xc1B621b18187F74c8F6D52a6F709Dd2780C09821
# Required. Gas units (not a fee) LayerZero's executor gives lzReceive on the adapter chain: one value per message
# whatever the batch size, and each hash takes a new storage slot there. ~200000 typical; into Tempo (4217) at
# least 600000. Replaces LZ_DEFAULT_FEE, which the scripts now refuse.
LZ_GAS_LIMIT=
# Required. Balance in wei to top the reporter up to (a target, not an amount to send); 0 = do not fund.
# Must be 0 when the endpoint charges fees in an ERC20 (Tempo): transfer that token instead.
LZ_REPORTER_FUNDING=

# ----------------------------------------------------------------------------
# Vea (--vea). Must be the two ends of one Vea route REPORTER_CHAIN_ID -> ADAPTER_CHAIN_ID; the chain ids come
# from REPORTER_CHAIN_ID / ADAPTER_CHAIN_ID. Fill per route; blank for the example route.
# ----------------------------------------------------------------------------

# Required. VeaInbox on the reporter chain / VeaOutbox on the adapter chain; code checked. With --vea,
# deploy-route.sh checks they are one Vea route before the preflight: the same epochPeriod() on both, an ArbToEth
# inbox's veaOutboxArbToEth() equal to VEA_OUTBOX, and matching Gnosis routers (routerArbToGnosis() /
# routerGnosisToArb()). A by-hand preflight checks only the ArbToEth case.
VEA_INBOX=
VEA_OUTBOX=

# ----------------------------------------------------------------------------
# Chainlink CCIP (--ccip). Fill per route; selectors are uint64, and each is checked on its own chain.
# ----------------------------------------------------------------------------

# Required. CCIP router on the reporter / adapter chain. The reporter router must support the adapter selector. The
# adapter router must have a live off-ramp from the reporter selector: an OffRamp (1.6 or later) with that source
# enabled for that router; a lane with only legacy EVM2EVMOffRamps passes with a WARNING, and a listed OffRamp with
# the source disabled or bound to another router fails. The preflight logs every listed off-ramp.
CCIP_REPORTER_ROUTER=
CCIP_ADAPTER_ROUTER=
# Required. CCIP chain selector of the reporter / adapter chain. The preflight checks each on its own chain: the
# reporter selector against the reporter router's on-ramp to the adapter selector, the adapter selector against the
# adapter router's off-ramp from the reporter selector. A real selector of another chain is refused there.
CCIP_REPORTER_CHAIN_SELECTOR=
CCIP_ADAPTER_CHAIN_SELECTOR=
# Optional. Gas units ccipReceive gets on the adapter chain, one value per message. Empty = the contract default
# 200000. Required into Tempo (4217), at least 600000 there. An explicit 0 is refused.
CCIP_GAS_LIMIT=
# Optional. ERC20 the reporter pays CCIP fees in. Empty = native (a zero address is refused). Required when the
# reporter chain is Tempo (4217), which has no native CCIP fees.
CCIP_FEE_TOKEN=
# Required. Balance in wei to top the reporter up to; 0 = do not fund. Must be 0 when CCIP_FEE_TOKEN is set:
# transfer the fee token instead.
CCIP_REPORTER_FUNDING=

# ----------------------------------------------------------------------------
# deBridge (--debridge)
# ----------------------------------------------------------------------------

# Required. DeBridgeGate on the reporter / adapter chain; code checked (same address on both chains here).
DEBRIDGE_REPORTER_GATE_ADDRESS=0x43dE2d77BF8027e25dBD179B491e8d64f38398aA
DEBRIDGE_ADAPTER_GATE_ADDRESS=0x43dE2d77BF8027e25dBD179B491e8d64f38398aA
# Required. deBridge chain ids of the reporter / adapter chain, checked against each gate's getChainId(). Usually the
# EVM id, but not always: Story (1514) is 100000013. No fallback to the EVM id.
DEBRIDGE_REPORTER_CHAIN_ID=42161
DEBRIDGE_ADAPTER_CHAIN_ID=100000013
# Required. Executor incentive in wei the reporter adds to each dispatch on top of the gate's globalFixedNativeFee.
# 0 is refused unless ALLOW_ZERO_FEE=true (and the keeper can never move a 0 fee).
DEBRIDGE_REPORTER_FEE=
# Required. Balance in wei to top the reporter up to; 0 = do not fund. One dispatch costs DEBRIDGE_REPORTER_FEE plus
# the gate's globalFixedNativeFee (0.001 ETH on Arbitrum on 2026-10-19; it can change).
DEBRIDGE_REPORTER_FUNDING=

# ----------------------------------------------------------------------------
# Axelar (--axelar). Fill per route; blank for the example route.
# ----------------------------------------------------------------------------

# Required. AxelarGateway and AxelarGasService on the reporter chain; code checked.
AXELAR_REPORTER_GATEWAY=
AXELAR_REPORTER_GAS_SERVICE=
# Required. AxelarGateway on the adapter chain; code checked.
AXELAR_ADAPTER_GATEWAY=
# Required. Axelar chain names (https://docs.axelar.dev/dev/reference/mainnet-chain-names). They must equal Axelar's
# axelarId exactly, case included ("Ethereum", "Polygon", "Avalanche" but "arbitrum", "base"): both contracts compare
# them byte for byte, and a wrong case deploys fine but never delivers. The preflight checks each name against
# chainName() of Axelar's InterchainTokenService on its own chain, and only warns (the name goes unchecked) where
# that contract has no code or its chainName() call fails or returns no readable string.
AXELAR_REPORTER_CHAIN_NAME=
AXELAR_ADAPTER_CHAIN_NAME=
# Required. Native gas in wei the reporter prepays per dispatch. Size it with AxelarQueryAPI.estimateGasFee();
# overpayment is refunded to the reporter. 0 is refused unless ALLOW_ZERO_FEE=true.
AXELAR_REPORTER_FEE=
# Required. Balance in wei to top the reporter up to (about AXELAR_REPORTER_FEE x expected dispatches); 0 = do not fund.
AXELAR_REPORTER_FUNDING=

# ----------------------------------------------------------------------------
# One-shot overrides: export in the shell for one run, never keep them set in .env.
# ----------------------------------------------------------------------------

# Deploy a new Yaho and Yaru instead of reusing the route's. Refused while YAHO_ADDRESS / YARU_ADDRESS are set or the
# route file holds any reporter, adapter, switch or lightbulb.
# FORCE_NEW_HASHI=false
# Accept DEBRIDGE_REPORTER_FEE=0 / AXELAR_REPORTER_FEE=0 (no executor incentive / no prepaid gas).
# ALLOW_ZERO_FEE=false
# Accept LZ_GAS_LIMIT / CCIP_GAS_LIMIT below 600000 into Tempo (4217), with a warning.
# ALLOW_LOW_DEST_GAS=false
# --set-dispatcher: replace a reporter's different nonzero dispatcher (a dispatch in flight through the old one is voided).
# REPLACE_DISPATCHER=false
# --handover: hand over reporters whose dispatcher is unset (prints each one's setDispatcher call for the governor).
# ALLOW_UNSET_DISPATCHER=false
# --handover: keeper set on every reporter before the governor moves. Default: KEEPER_ADDRESS, else the current keeper.
# Needed when KEEPER_ADDRESS is empty and the route has a paid reporter (or set KEEP_DEPLOYER_KEEPER). check() on a
# contract the governor already governs accepts its current keeper unless NEW_KEEPER is set.
# NEW_KEEPER=
# --handover: let the deployer stay keeper of the paid reporters (warns and logs their balances).
# KEEP_DEPLOYER_KEEPER=false
# Set by deploy-route.sh for the preflight (the selected bridges); set it only when running Preflight by hand.
# ROUTE_BRIDGES=
