VITE_ENVIO_URL=

# Per-chain RPC URL overrides. Each is optional — if unset, the chain's
# default public RPC (from viem/chains) is used instead. Set these to avoid
# rate limits/flakiness on public endpoints (especially Ethereum mainnet).
VITE_RPC_1=          # Ethereum
VITE_RPC_1514=       # Story
VITE_RPC_8453=       # Base
VITE_RPC_10200=      # Gnosis Chiado
VITE_RPC_42161=      # Arbitrum One
VITE_RPC_84532=      # Base Sepolia
VITE_RPC_421614=     # Arbitrum Sepolia
VITE_RPC_11155111=   # Ethereum Sepolia
