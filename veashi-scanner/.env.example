VITE_ENVIO_URL=

# Per-chain RPC URL overrides. Each is optional — if unset, the chain's
# default public RPC (from viem/chains) is used instead. Set these to avoid
# rate limits/flakiness on public endpoints (especially Ethereum mainnet).
VITE_RPC_1=          # Ethereum
VITE_RPC_1514=       # Story
VITE_RPC_8453=       # Base
VITE_RPC_10200=      # Gnosis Chiado
VITE_RPC_42161=      # Arbitrum One
VITE_RPC_84532=      # Base Sepolia
VITE_RPC_421614=     # Arbitrum Sepolia
VITE_RPC_11155111=   # Ethereum Sepolia

# Vea (snapshot/claim/verification) indexers — separate Envio projects from
# the Hashi indexer above, so they need their own URLs. Run `envio dev` in
# vea-envio-inbox/ and vea-envio-outbox/ separately; if running both locally
# at once, configure one to bind a different Hasura port (see that project's
# own .env) since both default to 8080.
VITE_VEA_INBOX_ENVIO_URL=
VITE_VEA_OUTBOX_ENVIO_URL=
